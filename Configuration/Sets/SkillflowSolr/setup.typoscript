#
# Skillflow – Solr skills index & search
#
# Registers the index queue for tx_nrllm_skill records, the facets,
# sorting and result-template path overrides for the EXT:skillflow skill
# documents. Depends on the base "apache-solr-for-typo3/solr" set.
#
# NOTE: category/tags/version/license are NOT mapped here on purpose – they
# are written into the Solr document by the PSR-14 indexing listener from the
# nr_llm raw_frontmatter column and optional catalogue overrides.
#

# -----------------------------------------------------------------------------
# (1) Index queue for skill records
# -----------------------------------------------------------------------------
plugin.tx_solr.index.queue {

  skills = 1
  skills {
    type = tx_nrllm_skill
    initialization = Webconsulting\Skillflow\Solr\SkillsRecordInitializer
    additionalWhereClause = enabled = 1 AND orphaned = 0

    # The initializer includes nr_llm's root records (pid=0). Extra storage
    # folders can be added with the constant exposed in constants.typoscript.
    additionalPageIds = {$plugin.tx_solr.index.queue.skills.additionalPageIds}

    fields {
      title = name
      description = description

      content = SOLR_CONTENT
      content {
        cObject = COA
        cObject {
          10 = TEXT
          10 {
            field = body
            noTrimWrap = || |
          }
          20 = TEXT
          20 {
            field = description
            noTrimWrap = || |
          }
        }
      }

      identifier_stringS = identifier
      sortTitle_stringS = name
      trustLevel_stringS = trust_level
      supportStatus_stringS = support_status

      url = TEXT
      url {
        typolink.parameter = {$plugin.tx_solr.index.queue.skills.detailPageId}
        typolink.additionalParams = &tx_skillflow_skilldetail[action]=show&tx_skillflow_skilldetail[controller]=SkillDetail&tx_skillflow_skilldetail[skill]={field:uid}&L={field:__solr_index_language}
        typolink.additionalParams.insertData = 1
        typolink.returnLast = url
      }

      rootline = {$plugin.tx_solr.index.queue.skills.detailPageId}

    }
  }

}

plugin.tx_solr.logging.indexing.queue.skills = 1

# -----------------------------------------------------------------------------
# (2) Faceting — labels are TEXT objects so they follow the site language.
# -----------------------------------------------------------------------------
plugin.tx_solr.search.faceting = 1
plugin.tx_solr.search.faceting {
  minimumCount = 1
  sortBy = count
  showEmptyFacets = 0

  facets {
    category {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.category
      field = category_stringS
    }
    tags {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.tags
      field = tags_stringM
    }
    source {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.source
      field = sourceTitle_stringS
    }
    tools {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.tools
      field = allowedTools_stringM
    }
    license {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.license
      field = license_stringS
    }
    trust {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.trust
      field = trustLevel_stringS
    }
    support {
      label = TEXT
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.facet.support
      field = supportStatus_stringS
    }
    type {
      label = Content type
      field = type
    }
  }
}

# -----------------------------------------------------------------------------
# (3) Sorting
# -----------------------------------------------------------------------------
plugin.tx_solr.search.sorting = 1
plugin.tx_solr.search.sorting {
  defaultOrder = asc

  options {
    relevance {
      field = relevance
      label = Relevance
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.sort.relevance
    }
    title {
      field = sortTitle_stringS
      label = Title
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.sort.title
    }
    category {
      field = category_stringS
      label = Category
      label.data = LLL:EXT:skillflow/Resources/Private/Language/locallang_db.xlf:search.sort.category
    }
  }
}

# -----------------------------------------------------------------------------
# (4) Results & highlighting
# -----------------------------------------------------------------------------
plugin.tx_solr.search.results {
  resultsPerPage = 12
  resultsPerPageSwitchOptions = 12,24,48

  resultsHighlighting = 1
  resultsHighlighting {
    highlightFields = content
  }
}

# NOTE: "browse the whole catalogue on the empty landing query" is NOT enabled
# globally here, because initializeWithEmptyQuery / allowEmptyQuery on the global
# plugin.tx_solr.search path would also force the site's general Solr search to
# dump all results. Enable it PER skill-listing page with a page-scoped TypoScript
# condition in the consuming site / site package, e.g.:
#
#   [page["uid"] in [<your skill listing page uids>]]
#   plugin.tx_solr.search {
#       initializeWithEmptyQuery = 1
#       showResultsOfInitialEmptyQuery = 1
#       query.allowEmptyQuery = 1
#   }
#   [END]

# -----------------------------------------------------------------------------
# (5) Skill result template / partial / layout overrides
# -----------------------------------------------------------------------------
plugin.tx_solr.view {
  templateRootPaths.200 = EXT:skillflow/Resources/Private/Solr/Templates/
  partialRootPaths.200 = EXT:skillflow/Resources/Private/Solr/Partials/
}

# -----------------------------------------------------------------------------
# (6) Skill detail plugin (skillflow_skilldetail) rendering
# -----------------------------------------------------------------------------
# On standard fluid_styled_content sites the plugin renders out of the box via
# ExtensionUtility::configurePlugin() (tt_content.skillflow_skilldetail = the
# EXTBASEPLUGIN). On sites whose lib.contentElement is a FLUIDTEMPLATE that maps
# CType -> a content template (e.g. desiderio), add a per-page override, e.g.:
#   [page["uid"] in [<detail page uids>]]
#   tt_content.skillflow_skilldetail >
#   tt_content.skillflow_skilldetail = COA
#   tt_content.skillflow_skilldetail.20 = EXTBASEPLUGIN
#   tt_content.skillflow_skilldetail.20 { extensionName = Skillflow; pluginName = SkillDetail }
#   [END]
