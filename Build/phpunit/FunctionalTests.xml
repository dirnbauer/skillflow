<?xml version="1.0" encoding="UTF-8"?>
<!--
    Defaults to an isolated SQLite database. Set the typo3Database* environment
    variables (driver mysqli, host, port, username, password, name) to run
    against MariaDB/MySQL instead; PHPUnit's <env> entries never override
    variables that are already present in the environment.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="FunctionalTestsBootstrap.php"
         backupGlobals="true"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnNotice="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         cacheDirectory="../../.Build/phpunit-functional">
    <testsuites>
        <testsuite name="functional">
            <directory>../../Tests/Functional</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="TYPO3_CONTEXT" value="Testing"/>
        <env name="typo3DatabaseDriver" value="pdo_sqlite"/>
    </php>
</phpunit>
