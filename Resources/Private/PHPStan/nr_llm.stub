<?php

/**
 * PHPStan type stubs for the parts of the OPTIONAL nr_llm extension
 * (netresearch/nr-llm) that skillflow talks to behind class_exists() guards.
 *
 * nr_llm is a soft dependency: it is not required in composer.json and is
 * absent from skillflow's standalone analysis environment, so without these
 * stubs PHPStan reports the classes as "not found" and every call on them as
 * "on mixed". These declarations mirror the real signatures (see
 * netresearch/nr-llm) so NrLlmRunner and NrLlmScanCredentials type-check
 * correctly. They are used by PHPStan only — never autoloaded at runtime.
 */

namespace Netresearch\NrLlm\Domain\Model;

class AdapterType
{
}

class Provider
{
    public function getAdapterType(): string {}
    public function getEndpointUrl(): string {}
    public function getDecryptedApiKey(): string {}
}

class Model
{
    public function getProvider(): ?Provider {}
    public function getModelId(): string {}
}

class LlmConfiguration
{
    public function getLlmModel(): ?Model {}
    public function hasAccessRestrictions(): bool {}
}

class CompletionResponse
{
    public function getText(): string {}
}

namespace Netresearch\NrLlm\Domain\Repository;

use Netresearch\NrLlm\Domain\Model\LlmConfiguration;

class LlmConfigurationRepository
{
    public function findDefault(): ?LlmConfiguration {}
}

namespace Netresearch\NrLlm\Service\Option;

class ChatOptions
{
    public function withMaxTokens(int $maxTokens): static {}
    public function withSystemPrompt(string $systemPrompt): static {}
}

namespace Netresearch\NrLlm\Service;

use Netresearch\NrLlm\Domain\Model\CompletionResponse;
use Netresearch\NrLlm\Service\Option\ChatOptions;

class LlmServiceManager
{
    public function hasAvailableProvider(): bool {}

    /**
     * @param array<int, array<string, string>> $messages
     */
    public function chat(array $messages, ?ChatOptions $options = null): CompletionResponse {}
}
