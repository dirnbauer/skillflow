{
    "name": "webconsulting/skillflow",
    "description": "Workflow assignments and runs for nr_llm skills on TYPO3 pages, users, and workspace stages.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "league/commonmark": "^2.7",
        "netresearch/nr-llm": "^0.25",
        "symfony/process": "^7.0",
        "symfony/yaml": "^7.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-workspaces": "^14.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "saschaegerer/phpstan-typo3": "^3.0.1"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\Skillflow\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\Skillflow\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "skillflow"
        }
    }
}
