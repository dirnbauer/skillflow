{
    "name": "webconsulting/skillflow",
    "description": "Run nr_llm-managed skills in TYPO3 page and workspace review workflows.",
    "homepage": "https://github.com/dirnbauer/skillflow",
    "keywords": [
        "TYPO3 CMS",
        "skills",
        "LLM",
        "nr_llm",
        "workspaces",
        "Solr"
    ],
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Kurt Dirnbauer",
            "email": "dirnbauer@webconsulting.at",
            "homepage": "https://webconsulting.at",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "apache-solr-for-typo3/solr": "^14.0.1",
        "league/commonmark": "^2.10",
        "netresearch/nr-llm": "^0.34 || ^0.35",
        "symfony/process": "^7.4",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-extbase": "^14.3.7",
        "typo3/cms-frontend": "^14.3.7",
        "typo3/cms-workspaces": "^14.3.7"
    },
    "require-dev": {
        "a9f/typo3-fractor": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpunit/phpunit": "^13.3",
        "saschaegerer/phpstan-typo3": "^3.1",
        "ssch/typo3-rector": "^3.16",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7",
        "webconsulting/typo3-abilities": "^1.3"
    },
    "suggest": {
        "webconsulting/typo3-abilities": "Skills declare the abilities they need (SKILL.md \"abilities:\"); the Claude CLI runner allows exactly those MCP tools and skillflow:check reports missing or denied ones"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-abilities",
            "canonical": true,
            "only": [
                "webconsulting/typo3-abilities"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Webconsulting\\Skillflow\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\Skillflow\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "cgl": "php-cs-fixer fix",
        "cgl:check": "php-cs-fixer check --diff",
        "rector": "rector process --dry-run",
        "fractor": "fractor process --dry-run",
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml"
    },
    "config": {
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/dirnbauer/skillflow/issues",
        "source": "https://github.com/dirnbauer/skillflow",
        "docs": "https://github.com/dirnbauer/skillflow/tree/main/Documentation"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "skillflow",
            "version": "1.9.1"
        }
    }
}
